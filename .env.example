# Google Cloud Console에서 만든 "웹 애플리케이션" OAuth 클라이언트 ID
GOOGLE_CLIENT_ID=

# 접속을 허용할 Google 계정. 여러 개면 쉼표로 구분
ALLOWED_EMAILS=cho711920@gmail.com

# 32자 이상의 임의 문자열. 외부 공개 금지
SESSION_SECRET=

# 현재 Apps Script 웹 앱 /exec 주소
APPS_SCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec

# Apps Script의 PROXY_SHARED_SECRET 속성과 반드시 같은 임의 문자열
APPS_SCRIPT_PROXY_SECRET=
