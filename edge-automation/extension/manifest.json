{
  "manifest_version": 3,
  "name": "JS 부동산 자동수집",
  "version": "1.0.25",
  "description": "Edge에서 네이버·당근·공실박스 수집기를 매일 순서대로 실행합니다.",
  "permissions": ["alarms", "notifications", "storage", "tabs"],
  "host_permissions": [
    "https://js-map.com/*",
    "https://www.js-map.com/*",
    "https://new.land.naver.com/*",
    "https://fin.land.naver.com/*",
    "https://realty.daangn.com/*",
    "https://gongsilbox.com/*",
    "https://*.gongsilbox.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "JS 자동수집",
    "default_popup": "options.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://new.land.naver.com/*", "https://fin.land.naver.com/*"],
      "js": ["collectors/naver-collector.js", "auto-bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://realty.daangn.com/*"],
      "js": ["collectors/daangn-collector.js", "auto-bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://gongsilbox.com/*", "https://*.gongsilbox.com/*"],
      "js": ["collectors/gongsil-collector.js", "auto-bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://js-map.com/*",
        "https://www.js-map.com/*",
        "https://new.land.naver.com/*",
        "https://fin.land.naver.com/*",
        "https://realty.daangn.com/*",
        "https://gongsilbox.com/*",
        "https://*.gongsilbox.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
